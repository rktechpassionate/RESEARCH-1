\subsection{Band-limited covariance kernel}

Let
\[
P_T(\gamma):=\left(\gamma^2+\frac14\right)\eta\!\left(\frac{\gamma}{T}\right),
\qquad
Q_T(\gamma):=P_T(\gamma)^2,
\qquad
\chi_{a,T}(\gamma):=P_T(\gamma)\cos(a\gamma),
\]
where $\eta\in C_c^\infty(\R)$ is even, $\eta\equiv 1$ on $[-1/2,1/2]$, and
$\supp(\eta)\subset[-1,1]$.

\begin{theorem}[Exact covariance kernel]\label{thm:band_cov}
For all $a,b\in\R$ and $T>0$,
\[
\int_{\R}\chi_{a,T}(\gamma)\chi_{b,T}(\gamma)\,d\gamma
=
\frac12\,\mathscr Q_T(a-b)+\frac12\,\mathscr Q_T(a+b),
\]
where
\[
\mathscr Q_T(t):=\int_{\R}Q_T(\gamma)e^{i\gamma t}\,d\gamma.
\]
In particular,
\[
\|\chi_{a,T}\|_{L^2(\R)}^2
=
\frac12\,\mathscr Q_T(0)+\frac12\,\mathscr Q_T(2a).
\]
\end{theorem}

\begin{proof}
Using
\[
\cos(a\gamma)\cos(b\gamma)=\frac12\bigl(\cos((a-b)\gamma)+\cos((a+b)\gamma)\bigr),
\]
we obtain
\begin{align*}
\int_{\R}\chi_{a,T}(\gamma)\chi_{b,T}(\gamma)\,d\gamma
&=
\frac12\int_{\R}Q_T(\gamma)\cos((a-b)\gamma)\,d\gamma
+\frac12\int_{\R}Q_T(\gamma)\cos((a+b)\gamma)\,d\gamma.
\end{align*}
Since $Q_T$ is even and real-valued,
\[
\int_{\R}Q_T(\gamma)\cos(t\gamma)\,d\gamma=\int_{\R}Q_T(\gamma)e^{i\gamma t}\,d\gamma=\mathscr Q_T(t),
\]
which proves the claim.
\end{proof}

\begin{corollary}[Exact self-overlap]\label{cor:self_overlap}
For every $a\in\R$ and $T>0$,
\[
\|\chi_{a,T}\|_{L^2(\R)}^2=\frac12\mathscr Q_T(0)+\frac12\mathscr Q_T(2a).
\]
\end{corollary}

\begin{proof}
Set $b=a$ in Theorem~\ref{thm:band_cov}.
\end{proof}

