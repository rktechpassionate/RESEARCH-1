\subsection{Spectral curvature at the origin}

Let $\Phi_{a,\sigma}=G_{a,\sigma}*\widetilde G_{a,\sigma}$ be the Gaussian autocorrelation from
Theorem~\ref{thm:decomp}.

\begin{theorem}[Exact curvature identity]\label{thm:curvature}
The Fourier transform of $\Phi_{a,\sigma}$ satisfies
\[
\widehat{\Phi}_{a,\sigma}''(0)
=
e^{-a^2/\sigma^2}\left(
4+\frac{a^2}{2\sigma^4}-\frac{1}{2\sigma^2}
\right).
\]
Equivalently,
\[
\int_{\R}x^2\Phi_{a,\sigma}(x)\,dx
=
-e^{-a^2/\sigma^2}\left(
4+\frac{a^2}{2\sigma^4}-\frac{1}{2\sigma^2}
\right).
\]
\end{theorem}

\begin{proof}
By definition,
\[
\widehat{\Phi}_{a,\sigma}(\xi)=|\wh G_{a,\sigma}(\xi)|^2
=
\left(\xi^2+\frac14\right)^2
\Bigl[
e^{-(\xi-a)^2/\sigma^2}+e^{-(\xi+a)^2/\sigma^2}+2e^{-(\xi^2+a^2)/\sigma^2}
\Bigr].
\]
Write
\[
P(\xi)=\left(\xi^2+\frac14\right)^2,\qquad
Q(\xi)=e^{-(\xi-a)^2/\sigma^2}+e^{-(\xi+a)^2/\sigma^2}+2e^{-(\xi^2+a^2)/\sigma^2}.
\]
Then $P(0)=1/16$, $P'(0)=0$, $P''(0)=1$, and
\[
Q(0)=4e^{-a^2/\sigma^2},
\qquad
Q''(0)=\left(\frac{8a^2}{\sigma^4}-\frac{8}{\sigma^2}\right)e^{-a^2/\sigma^2}.
\]
Hence
\[
\widehat{\Phi}_{a,\sigma}''(0)
=
P''(0)Q(0)+P(0)Q''(0)
=
e^{-a^2/\sigma^2}\left(
4+\frac{a^2}{2\sigma^4}-\frac{1}{2\sigma^2}
\right).
\]
Finally, since
\[
\widehat{\Phi}_{a,\sigma}''(0)
=
\int_{\R}(-ix)^2\Phi_{a,\sigma}(x)\,dx
=
-\int_{\R}x^2\Phi_{a,\sigma}(x)\,dx,
\]
the second identity follows.
\end{proof}

\begin{remark}
This gives a closed formula for the ``spectral curvature'' of the autocorrelation at the origin.
It is useful as a quantitative measure of how sharply the Gaussian packet is localized.
\end{remark}

