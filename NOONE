\subsection{Exact mass and $L^2$ normalization}

\begin{theorem}[Exact total mass and $L^2$ norm]\label{thm:mass_L2}
For the Gaussian family $f_{\gamma_0,\sigma}$ of Definition~\ref{def:f},
\[
\Phi_{\gamma_0,\sigma}(0)=\|f_{\gamma_0,\sigma}\|_{L^2(\R)}^2
=
\frac{\sigma}{\sqrt\pi}\left(
\gamma_0^4+\frac{\gamma_0^2}{2}+3\gamma_0^2\sigma^2+\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}
+e^{-\gamma_0^2/\sigma^2}\left(\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\right)
\right).
\]
Moreover,
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx=\frac14\,e^{-\gamma_0^2/\sigma^2}.
\]
\end{theorem}

\begin{proof}
Since $\Phi_{\gamma_0,\sigma}=f_{\gamma_0,\sigma}*\widetilde f_{\gamma_0,\sigma}$ and
$\widetilde f_{\gamma_0,\sigma}(x)=f_{\gamma_0,\sigma}(-x)$, we have
\[
\Phi_{\gamma_0,\sigma}(0)=\int_{\R}|f_{\gamma_0,\sigma}(x)|^2\,dx
=\|f_{\gamma_0,\sigma}\|_{L^2(\R)}^2.
\]
Evaluating the explicit formula from Theorem~\ref{thm:decomp} at $x=0$ gives the stated expression.
For the total mass,
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx=\widehat{\Phi}_{\gamma_0,\sigma}(0)
=|\wh f_{\gamma_0,\sigma}(0)|^2.
\]
Now
\[
\wh f_{\gamma_0,\sigma}(0)
=
\left(\frac14\right)\left(e^{-\gamma_0^2/(2\sigma^2)}+e^{-\gamma_0^2/(2\sigma^2)}\right)
=
\frac12 e^{-\gamma_0^2/(2\sigma^2)},
\]
so
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx
=
\left(\frac12 e^{-\gamma_0^2/(2\sigma^2)}\right)^2
=
\frac14 e^{-\gamma_0^2/\sigma^2}.
\]
\end{proof}

\begin{corollary}[Exponential mass localization]\label{cor:mass_localization}
As $\gamma_0/\sigma\to\infty$,
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx = O\!\left(e^{-\gamma_0^2/\sigma^2}\right).
\]
\end{corollary}

\begin{proof}
Immediate from Theorem~\ref{thm:mass_L2}.
\end{proof}

