\subsection{Exponential type and derivative bounds for band-limited autocorrelations}

Let
\[
\Phi_{a,T}:=f_{a,T}*\widetilde f_{a,T},
\qquad
\widetilde f_{a,T}(x)=f_{a,T}(-x).
\]
Since $\wh\Phi_{a,T}=|\chi_{a,T}|^2$ and $\supp(\chi_{a,T})\subset[-T,T]$, we have
\[
\Phi_{a,T}(z)=\frac{1}{2\pi}\int_{-T}^{T}|\chi_{a,T}(\gamma)|^2 e^{i\gamma z}\,d\gamma,
\qquad z\in\C.
\]

\begin{theorem}[Exponential type and derivative bounds]\label{thm:typebounds}
For every $m\ge 0$ and every $z\in\C$,
\[
\left|\Phi_{a,T}^{(m)}(z)\right|
\le
\frac{T^m}{2\pi}\,\|\chi_{a,T}\|_{L^2(\R)}^2\,e^{T|\Im z|}.
\]
In particular, $\Phi_{a,T}$ extends to an entire function of exponential type at most $T$:
\[
|\Phi_{a,T}(z)|\le C_{a,T}e^{T|\Im z|},
\qquad
C_{a,T}:=\frac{1}{2\pi}\|\chi_{a,T}\|_{L^2(\R)}^2.
\]
\end{theorem}

\begin{proof}
Differentiate under the integral sign:
\[
\Phi_{a,T}^{(m)}(z)
=
\frac{1}{2\pi}\int_{-T}^{T}(i\gamma)^m|\chi_{a,T}(\gamma)|^2 e^{i\gamma z}\,d\gamma.
\]
Therefore
\[
\bigl|\Phi_{a,T}^{(m)}(z)\bigr|
\le
\frac{1}{2\pi}\int_{-T}^{T}|\gamma|^m |\chi_{a,T}(\gamma)|^2 e^{-\gamma\,\Im z}\,d\gamma
\le
\frac{T^m e^{T|\Im z|}}{2\pi}\int_{-T}^{T}|\chi_{a,T}(\gamma)|^2\,d\gamma.
\]
Since $\int_{-T}^{T}|\chi_{a,T}|^2=\|\chi_{a,T}\|_{L^2(\R)}^2$, the result follows.
\end{proof}

\begin{corollary}[Exact mass of the band-limited autocorrelation]\label{cor:band_mass}
If $\eta(0)=1$, then
\[
\int_{\R}\Phi_{a,T}(x)\,dx
=
|\chi_{a,T}(0)|^2
=
\frac1{16}.
\]
\end{corollary}

\begin{proof}
By Fourier inversion,
\[
\int_{\R}\Phi_{a,T}(x)\,dx=\widehat{\Phi}_{a,T}(0)=|\chi_{a,T}(0)|^2.
\]
Since $P_T(0)=\frac14\eta(0)=\frac14$ and $\cos(0)=1$, we get
$\chi_{a,T}(0)=\frac14$, hence the claim.
\end{proof}

%=======================================================================

\subsection{A clean large-frequency asymptotic for the Gaussian profile}

\begin{theorem}[Leading-frequency asymptotic]\label{thm:largefreq}
Fix $\sigma>0$ and let $K\subset\R$ be compact. Then uniformly for $x\in K$,
\[
\Phi_{a,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}\,e^{-\sigma^2x^2/4}
\left(
a^4\cos(ax)-2a^3\sigma^2x\sin(ax)+O_{\sigma,K}(a^2)
\right)
\qquad (a\to\infty).
\]
In particular,
\[
\Phi_{a,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}\,a^4\,e^{-\sigma^2x^2/4}\cos(ax)
+O_{\sigma,K}(a^3).
\]
\end{theorem}

\begin{proof}
Substitute the explicit formula from Theorem~\ref{thm:decomp}. The polynomial
\[
\mathcal A_{a,\sigma}(x)=a^4+O_{\sigma,K}(a^2),
\qquad
\mathcal S_{a,\sigma}(x)=2a^3\sigma^2x+O_{\sigma,K}(a)
\]
uniformly for $x\in K$, while the diagonal correction
$e^{-a^2/\sigma^2}\mathcal A_{0,\sigma}(x)$ is exponentially small.
\end{proof}

