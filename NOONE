\begin{abstract}
We develop explicit and fully rigorous formulas for a concrete admissible Gaussian family in the Weil quadratic-form framework.
We prove an exact shifted-Gaussian autocorrelation decomposition that includes both cosine and sine modulations,
with all polynomial coefficients derived in full detail.
We establish a quantitative exponential decoupling bound with an explicit constant,
and we give an exact complex-frequency evaluation with explicit relative error control,
which is directly relevant for detecting off-critical zeros.
Using the standard Guinand--Weil/Bombieri decomposition, we then derive a fully explicit conditional inequality
for weighted prime sums under the Riemann Hypothesis.
All computations are self-contained and all constants are explicitly given.
\end{abstract}

\section{Introduction}

Let $\zeta(s)$ be the Riemann zeta function. For a non-trivial zero $\rho=\beta+i\gamma$ of $\zeta(s)$,
define the spectral parameter
\[
\gamma_\rho := \frac{\rho-\frac12}{i} = \gamma - i\Bigl(\beta-\frac12\Bigr)\in\C.
\]
Hence $\gamma_\rho\in\R$ if and only if $\beta=\tfrac12$ (i.e. the zero lies on the critical line).

We work with the Weil quadratic form (in the Bombieri/Guinand--Weil normalization):
\[
\mathcal W(f)=\sum_{\rho}\wh f(\gamma_\rho)^2,
\]
for $f$ in a standard admissible Schwartz class $\Szero$ (even, real-valued Schwartz functions with $\wh f(\pm i/2)=0$).

A Guinand--Weil explicit formula gives a decomposition
\begin{equation}\label{eq:Wdecomp}
\mathcal W(f)=\mathcal K(f)-\mathcal B(f),
\end{equation}
where $\mathcal K(f)$ is an archimedean term and $\mathcal B(f)$ is a prime-sum term.
Under the Riemann Hypothesis (RH), $\gamma_\rho\in\R$ for all zeros, so $\wh f(\gamma_\rho)$ is real for admissible $f$ and $\mathcal W(f)\ge 0$;
plugging \eqref{eq:Wdecomp} then yields the inequality $\mathcal B(f)\le\mathcal K(f)$.

This paper constructs a concrete family $\{f_{\gamma_0,\sigma}\}$ built from symmetrized Gaussians
and proves explicit structural identities for its autocorrelation
$\Phi_{\gamma_0,\sigma}=f_{\gamma_0,\sigma}*\widetilde f_{\gamma_0,\sigma}$.
The conditional prime-sum inequality is then derived directly from \eqref{eq:Wdecomp}.

\section{Preliminaries}

\subsection{Fourier transform convention}
We use
\[
\wh f(\xi)=\int_{\R} f(x)e^{-i\xi x}\,dx,\qquad
f(x)=\frac{1}{2\pi}\int_{\R}\wh f(\xi)e^{i\xi x}\,d\xi.
\]
Parseval's identity reads
\[
\|f\|_{L^2(\R)}^2=\frac{1}{2\pi}\|\wh f\|_{L^2(\R)}^2.
\]

\subsection{Admissible test functions and Weil quadratic form}
Let $\Szero$ denote the space of even, real-valued Schwartz functions $f$ on $\R$ such that $\wh f(\pm i/2)=0$.

\begin{definition}
For $f\in\Szero$, the Weil quadratic form is
\[
\mathcal W(f)=\sum_{\rho}\wh f(\gamma_\rho)^2,
\]
where the sum runs over non-trivial zeros $\rho$ of $\zeta(s)$, counted with multiplicity.
\end{definition}

\subsection{Guinand--Weil/Bombieri decomposition (cited input)}
In the standard normalization (see \cite[\S2]{Bombieri2000}), for admissible $f$ one has \eqref{eq:Wdecomp} with
\begin{align}
\mathcal K(f) &= \frac{1}{\pi}\int_{0}^{\infty}\Re\Psi\!\Bigl(\frac14+\frac{i\gamma}{2}\Bigr)\,|\wh f(\gamma)|^2\,d\gamma
-\Phi(0)\log\pi,\label{eq:Kdef}\\
\mathcal B(f) &= \frac{1}{\pi}\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\sqrt{n}}\,\Phi(\log n),\label{eq:Bdef}
\end{align}
where $\Psi=\Gamma'/\Gamma$ is the digamma function,
$\Lambda(n)$ is the von Mangoldt function, and
\[
\Phi=f*\widetilde f,\qquad \widetilde f(x)=f(-x).
\]

\subsection{Digamma asymptotics and convergence}
For $\gamma>0$, $\Re\Psi(\tfrac14+i\gamma/2)=\log(\gamma/2)+O(1/\gamma^2)$ as $\gamma\to\infty$ \cite[§9.7]{Titchmarsh}.
Since $\wh f_{\gamma_0,\sigma}$ decays like a Gaussian, the integral in \eqref{eq:Kdef} converges absolutely.
The prime sum \eqref{eq:Bdef} converges absolutely because
$|\Phi_{\gamma_0,\sigma}(x)|\le C e^{-\sigma^2 x^2/4}$ (see Theorem~\ref{thm:decomp} and the explicit estimate in Section~8),
making the terms $O(n^{-\sigma^2\ln n/4})$ which decay faster than any power of $n$.

\section{The entire Gaussian family}

\begin{definition}\label{def:f}
Fix $\sigma>0$ and $\gamma_0\ge 0$. Define an entire Fourier-side function by
\begin{equation}\label{eq:fhat}
\wh f_{\gamma_0,\sigma}(\gamma)
=
\Bigl(\gamma^2+\frac14\Bigr)\left(
e^{-(\gamma-\gamma_0)^2/(2\sigma^2)}
+
e^{-(\gamma+\gamma_0)^2/(2\sigma^2)}
\right),
\qquad \gamma\in\C.
\end{equation}
Let $f_{\gamma_0,\sigma}$ be the inverse Fourier transform of $\wh f_{\gamma_0,\sigma}$ (on $\R$).
Define the autocorrelation
\[
\Phi_{\gamma_0,\sigma} := f_{\gamma_0,\sigma}*\widetilde f_{\gamma_0,\sigma}.
\]
\end{definition}

\begin{lemma}\label{lem:admissible}
For every $\sigma>0$ and $\gamma_0\ge 0$, one has $f_{\gamma_0,\sigma}\in\Szero$.
\end{lemma}
\begin{proof}
The right-hand side of \eqref{eq:fhat} is entire and even in $\gamma$, and it is real-valued for $\gamma\in\R$.
Moreover it vanishes at $\gamma=\pm i/2$ due to the factor $\gamma^2+\frac14$.
Since it is a Gaussian times a polynomial, its restriction to $\R$ is Schwartz, so its inverse Fourier transform is even,
real-valued, and Schwartz. Hence $f_{\gamma_0,\sigma}\in\Szero$.
\end{proof}

\section{Gaussian moment integrals}

\begin{lemma}\label{lem:moments}
For $\sigma>0$ and $k\in\{0,1,2,3,4\}$, define
\[
I_k(x;\sigma)=\int_{-\infty}^{\infty} u^k e^{-u^2/\sigma^2}e^{iux}\,du.
\]
Then
\begin{align*}
I_0 &= \sigma\sqrt{\pi}\,e^{-\sigma^2 x^2/4},\\
I_1 &= i\,\frac{\sigma^3\sqrt{\pi}}{2}\,x\,e^{-\sigma^2 x^2/4},\\
I_2 &= \sigma\sqrt{\pi}\left(\frac{\sigma^2}{2}-\frac{\sigma^4 x^2}{4}\right)e^{-\sigma^2 x^2/4},\\
I_3 &= i\,\sigma\sqrt{\pi}\left(\frac{3\sigma^4 x}{4}-\frac{\sigma^6 x^3}{8}\right)e^{-\sigma^2 x^2/4},\\
I_4 &= \sigma\sqrt{\pi}\left(\frac{3\sigma^4}{4}-\frac{3\sigma^6 x^2}{4}+\frac{\sigma^8 x^4}{16}\right)e^{-\sigma^2 x^2/4}.
\end{align*}
\end{lemma}
\begin{proof}
The base case $I_0$ follows from completing the square in the exponent.
For $k\ge 1$, note that $u e^{iux} = -i\frac{d}{dx}e^{iux}$, so $I_k = (-i)^k \frac{d^k}{dx^k} I_0$.
Differentiating $e^{-\sigma^2 x^2/4}$ repeatedly yields the stated expressions.
\end{proof}

\section{Exact shifted-Gaussian autocorrelation decomposition}

\begin{theorem}[Shifted-Gaussian autocorrelation decomposition]\label{thm:decomp}
For any $x\in\R$,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt{\pi}}e^{-\sigma^2 x^2/4}
\Bigl[
\mathcal A_{\gamma_0,\sigma}(x)\cos(\gamma_0 x)
-
\mathcal S_{\gamma_0,\sigma}(x)\sin(\gamma_0 x)
+
e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\Bigr],
\]
where the explicit polynomials are
\begin{align}
\mathcal A_{\gamma_0,\sigma}(x)
&=
\Bigl(\gamma_0^4+\frac{\gamma_0^2}{2}+3\gamma_0^2\sigma^2+\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\Bigr)
-\Bigl(\frac{3\gamma_0^2\sigma^4}{2}+\frac{3\sigma^6}{4}+\frac{\sigma^4}{8}\Bigr)x^2
+\frac{\sigma^8}{16}x^4,\label{eq:A}\\[2pt]
\mathcal S_{\gamma_0,\sigma}(x)
&=
\gamma_0\Bigl(2\gamma_0^2\sigma^2+3\sigma^4+\frac{\sigma^2}{2}\Bigr)x
-\frac{\gamma_0\sigma^6}{2}x^3,\label{eq:S}\\[2pt]
\mathcal A_{0,\sigma}(x)
&=
\Bigl(\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\Bigr)
-\Bigl(\frac{3\sigma^6}{4}+\frac{\sigma^4}{8}\Bigr)x^2
+\frac{\sigma^8}{16}x^4.\label{eq:A0}
\end{align}
\end{theorem}

\begin{proof}
From \eqref{eq:fhat} we have
\[
|\wh f_{\gamma_0,\sigma}(\gamma)|^2
= \Bigl(\gamma^2+\frac14\Bigr)^2\left[
e^{-(\gamma-\gamma_0)^2/\sigma^2}
+ e^{-(\gamma+\gamma_0)^2/\sigma^2}
+ 2e^{-(\gamma^2+\gamma_0^2)/\sigma^2}
\right].
\]
Let $A_+(\gamma)$, $A_-(\gamma)$, and $B(\gamma)$ denote the three summands.

\noindent\textbf{Shifted terms $A_\pm$.}
For $A_+$, substitute $u=\gamma-\gamma_0$. Then $\gamma = u+\gamma_0$, and expanding the shifted quartic gives
\begin{align}\label{eq:shifted_quartic}
\bigl[(u+\gamma_0)^2+\tfrac14\bigr]^2
&= u^4 + 4\gamma_0 u^3 + (6\gamma_0^2+\tfrac12)u^2 + (4\gamma_0^3+\gamma_0)u + (\gamma_0^4+\tfrac{\gamma_0^2}{2}+\tfrac1{16})\nonumber\\
&=: c_4 u^4 + c_3 u^3 + c_2 u^2 + c_1 u + c_0.
\end{align}
The inverse Fourier transform of $A_+$ is
\[
I_+(x) = \frac{1}{2\pi}\int_{-\infty}^\infty \Bigl(\gamma^2+\tfrac14\Bigr)^2 e^{-(\gamma-\gamma_0)^2/\sigma^2} e^{i\gamma x}\,d\gamma
= \frac{e^{i\gamma_0 x}}{2\pi}\sum_{k=0}^4 c_k I_k(x;\sigma).
\]
For $A_-$, replace $\gamma_0$ by $-\gamma_0$, giving coefficients $c_k' = (-1)^k c_k$, so
\[
I_-(x) = \frac{e^{-i\gamma_0 x}}{2\pi}\sum_{k=0}^4 (-1)^k c_k I_k(x;\sigma).
\]

Now substitute the explicit $I_k$ from Lemma~\ref{lem:moments}. For even $k$ ($0,2,4$), $I_k$ is real; for odd $k$ ($1,3$), $I_k$ is purely imaginary.
Summing $I_+ + I_-$, the odd-$k$ imaginary parts combine with $e^{i\gamma_0 x} - e^{-i\gamma_0 x} = 2i\sin(\gamma_0 x)$ to produce the sine term, while the even-$k$ real parts combine with $e^{i\gamma_0 x} + e^{-i\gamma_0 x} = 2\cos(\gamma_0 x)$ to produce the cosine term.
Carrying out the algebra:
\begin{align*}
\text{Constant term:} &\quad c_0 I_0 + c_2 I_2|_{\text{const}} + c_4 I_4|_{\text{const}} \\
&= \Bigl(\gamma_0^4+\frac{\gamma_0^2}{2}+\frac1{16}\Bigr) + (6\gamma_0^2+\tfrac12)\frac{\sigma^2}{2} + \frac{3\sigma^4}{4} \\
&= \gamma_0^4+\frac{\gamma_0^2}{2}+3\gamma_0^2\sigma^2+\frac{\sigma^2}{4}+\frac{3\sigma^4}{4}+\frac1{16}.
\end{align*}
\begin{align*}
\text{$x^2$ coefficient:} &\quad c_2 (-\tfrac{\sigma^4}{4}) + c_4 (-\tfrac{3\sigma^6}{4}) \\
&= -(6\gamma_0^2+\tfrac12)\frac{\sigma^4}{4} - \frac{3\sigma^6}{4}
= -\frac{3\gamma_0^2\sigma^4}{2} - \frac{\sigma^4}{8} - \frac{3\sigma^6}{4}.
\end{align*}
\begin{align*}
\text{$x^4$ coefficient:} &\quad c_4 \frac{\sigma^8}{16} = \frac{\sigma^8}{16}.
\end{align*}
This yields exactly $\mathcal A_{\gamma_0,\sigma}(x)$ in \eqref{eq:A}.

For the odd part, the contributions are
\begin{align*}
\text{$x$ coefficient:} &\quad c_1 I_1|_{\text{coeff}} + c_3 I_3|_{\text{coeff}} \\
&= (4\gamma_0^3+\gamma_0)\frac{\sigma^2}{2} + 4\gamma_0\frac{3\sigma^4}{4}
= 2\gamma_0^3\sigma^2 + \frac{\gamma_0\sigma^2}{2} + 3\gamma_0\sigma^4.
\end{align*}
\begin{align*}
\text{$x^3$ coefficient:} &\quad c_3 (-\tfrac{\sigma^6}{8}) = -4\gamma_0\frac{\sigma^6}{8} = -\frac{\gamma_0\sigma^6}{2}.
\end{align*}
Multiplying by the factor $\sigma\sqrt{\pi}/\pi$ (which becomes $\sigma/\sqrt{\pi}$ after division by $2\pi$) and including the $2\sin(\gamma_0 x)$ from the exponential combination gives $\mathcal S_{\gamma_0,\sigma}(x)$ in \eqref{eq:S}.

\noindent\textbf{Cross term $B(\gamma)$.}
For $B(\gamma) = 2(\gamma^2+\tfrac14)^2 e^{-(\gamma^2+\gamma_0^2)/\sigma^2}$, we have
\[
I_B(x) = \frac{1}{2\pi}\int_{-\infty}^\infty 2(\gamma^2+\tfrac14)^2 e^{-(\gamma^2+\gamma_0^2)/\sigma^2} e^{i\gamma x}\,d\gamma
= e^{-\gamma_0^2/\sigma^2} \cdot \frac{1}{\pi}\int_{-\infty}^\infty (\gamma^2+\tfrac14)^2 e^{-\gamma^2/\sigma^2} e^{i\gamma x}\,d\gamma.
\]
The remaining integral is $I_+$ with $\gamma_0=0$. Setting $\gamma_0=0$ in \eqref{eq:shifted_quartic} makes $c_1=c_3=0$, $c_0=1/16$, $c_2=1/2$, $c_4=1$. Repeating the even-$k$ computation above gives exactly $\mathcal A_{0,\sigma}(x)$ in \eqref{eq:A0}, multiplied by $\sigma/\sqrt{\pi}$. Thus
\[
I_B(x) = e^{-\gamma_0^2/\sigma^2} \cdot \frac{\sigma}{\sqrt{\pi}} e^{-\sigma^2 x^2/4} \mathcal A_{0,\sigma}(x).
\]

\noindent\textbf{Assembly.}
Since $\Phi_{\gamma_0,\sigma}(x) = I_+(x) + I_-(x) + I_B(x)$, we obtain the claimed decomposition.
\end{proof}

\begin{remark}[Evenness and value at $x=0$]
The cosine term is even (even polynomial $\times$ even cosine), the sine term is odd $\times$ odd = even,
and the diagonal term is even; hence $\Phi_{\gamma_0,\sigma}(-x)=\Phi_{\gamma_0,\sigma}(x)$.
At $x=0$, $\sin$ vanishes and $\cos=1$, so
\[
\Phi_{\gamma_0,\sigma}(0) = \frac{\sigma}{\sqrt{\pi}}\Bigl[\mathcal A_{\gamma_0,\sigma}(0) + e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(0)\Bigr],
\]
which yields the explicit expression
\[
\Phi_{\gamma_0,\sigma}(0) = \frac{\sigma}{\sqrt{\pi}}
\Bigl[\gamma_0^4+\frac{\gamma_0^2}{2}+3\gamma_0^2\sigma^2+\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}
+ e^{-\gamma_0^2/\sigma^2}\Bigl(\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\Bigr)\Bigr].
\]
\end{remark}

\section{Oscillatory decoupling with an explicit constant}

\begin{theorem}[Exponential decoupling with explicit uniform bound]\label{thm:decouple}
For all $x\in\R$,
\[
\left|
\frac{\sigma}{\sqrt{\pi}}e^{-\sigma^2 x^2/4}e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\right|
\le
C_\sigma\,e^{-\gamma_0^2/\sigma^2},
\]
where one may take the explicit constant
\begin{align*}
C_\sigma
&=
\frac{\sigma}{\sqrt{\pi}}\left(
a_0 + a_2\frac{4}{\sigma^2 e} + a_4\frac{64}{\sigma^4 e^2}
\right),\\[2pt]
a_0 &= \frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac{1}{16},\quad
a_2 = \frac{3\sigma^6}{4}+\frac{\sigma^4}{8},\quad
a_4 = \frac{\sigma^8}{16}.
\end{align*}
\end{theorem}

\begin{proof}
From \eqref{eq:A0}, we have
\[
\mathcal A_{0,\sigma}(x) = a_0 - a_2 x^2 + a_4 x^4,
\]
with $a_0,a_2,a_4$ as defined. By the triangle inequality,
\[
|\mathcal A_{0,\sigma}(x)| \le a_0 + a_2 |x|^2 + a_4 |x|^4 = a_0 + a_2 x^2 + a_4 x^4.
\]
Let $b = \sigma^2/4$, so that $e^{-\sigma^2 x^2/4}=e^{-b x^2}$.
The function $f(t)=t^2 e^{-b t^2}$ attains its maximum at $t = \pm 1/\sqrt{b}$, where $f(1/\sqrt{b}) = \frac{1}{b e}$.
Similarly, $g(t)=t^4 e^{-b t^2}$ attains its maximum at $t = \pm\sqrt{2/b}$, where $g(\sqrt{2/b}) = \frac{4}{b^2 e^2}$.
Therefore,
\[
\sup_{x\in\R} (a_0 + a_2 x^2 + a_4 x^4) e^{-b x^2}
\le a_0 + a_2\frac{1}{b e} + a_4\frac{4}{b^2 e^2}.
\]
Substituting $b = \sigma^2/4$ gives $\frac{1}{b e} = \frac{4}{\sigma^2 e}$ and $\frac{4}{b^2 e^2} = \frac{4}{(\sigma^4/16)e^2} = \frac{64}{\sigma^4 e^2}$.
Multiplying by the prefactor $\sigma/\sqrt{\pi}$ and the factor $e^{-\gamma_0^2/\sigma^2}$ completes the proof.
\end{proof}

\begin{remark}
Because the expression is a Gaussian times a polynomial, it decays faster than any polynomial;
hence for any $N\ge 0$ there exists $C_{\sigma,N}$ such that the same diagonal term is
$\le C_{\sigma,N} e^{-\gamma_0^2/\sigma^2} (1+|x|)^{-N}$. This stronger estimate guarantees absolute convergence of the prime sum in \eqref{eq:Bdef} after substitution $x=\ln n$.
\end{remark}

\section{Complex-frequency evaluation with explicit relative error}

\begin{definition}\label{def:notch}
For $\delta>0$, define the notch-filtered family
\[
\wh g_{\gamma_0,\sigma}(\gamma):=(\gamma^2-\gamma_0^2)\,\wh f_{\gamma_0,\sigma}(\gamma).
\]
Let $z_0:=\gamma_0-i\delta$. This $z_0$ corresponds to a hypothetical off-critical zero
$\rho_0 = \frac12+\delta+i\gamma_0$, which would contribute a complex spectral point $\gamma_{\rho_0}=z_0$.
\end{definition}

\begin{proposition}[Complex-frequency amplification with explicit error]\label{prop:complexamp}
Fix $\delta>0$ and $\gamma_0\ge 0$.
For $z_0=\gamma_0-i\delta$, the exact evaluation
\[
\wh g_{\gamma_0,\sigma}(z_0)
=
(z_0^2-\gamma_0^2)\Bigl(z_0^2+\frac14\Bigr)\,
e^{\delta^2/(2\sigma^2)}\,(1+\Theta_{\gamma_0,\delta,\sigma})
\]
holds with
\[
\Theta_{\gamma_0,\delta,\sigma}=e^{-2\gamma_0^2/\sigma^2}\,e^{2i\gamma_0\delta/\sigma^2},
\qquad
|\Theta_{\gamma_0,\delta,\sigma}|=e^{-2\gamma_0^2/\sigma^2}.
\]
Moreover, the squared real part satisfies
\[
\Bigl|\Re\bigl(\wh g_{\gamma_0,\sigma}(z_0)^2\bigr) - \Re\bigl(A(z_0)^2\bigr)e^{\delta^2/\sigma^2}\Bigr|
\le 3 e^{-2\gamma_0^2/\sigma^2} |A(z_0)|^2 e^{\delta^2/\sigma^2},
\]
where $A(z_0)=(z_0^2-\gamma_0^2)(z_0^2+1/4)$. If $\gamma_0 \ge \delta$, then $\Re(A(z_0)^2) < 0$.
\end{proposition}

\begin{proof}
Substituting $\gamma=z_0$ into \eqref{eq:fhat} gives
\[
\wh g_{\gamma_0,\sigma}(z_0) = (z_0^2-\gamma_0^2)\Bigl(z_0^2+\frac14\Bigr)
\Bigl[e^{-(z_0-\gamma_0)^2/(2\sigma^2)} + e^{-(z_0+\gamma_0)^2/(2\sigma^2)}\Bigr].
\]
Since $z_0-\gamma_0 = -i\delta$, the first exponential is $e^{\delta^2/(2\sigma^2)}$.
For the second, $z_0+\gamma_0 = 2\gamma_0-i\delta$, so
\[
e^{-(z_0+\gamma_0)^2/(2\sigma^2)}
= e^{-2\gamma_0^2/\sigma^2}\,e^{\delta^2/(2\sigma^2)}\,e^{2i\gamma_0\delta/\sigma^2}.
\]
Factoring $e^{\delta^2/(2\sigma^2)}$ yields the representation with $\Theta$.

Squaring and writing $(1+\Theta)^2 = 1 + 2\Theta + \Theta^2$, we have
\[
\bigl|\Re(\wh g^2) - \Re(A^2)e^{\delta^2/\sigma^2}\bigr|
\le |A|^2 e^{\delta^2/\sigma^2} \bigl(2|\Theta| + |\Theta|^2\bigr)
\le 3 e^{-2\gamma_0^2/\sigma^2} |A|^2 e^{\delta^2/\sigma^2},
\]
using $|\Theta|\le 1$. For the negativity: compute $z_0^2-\gamma_0^2 = -\delta^2-2i\gamma_0\delta$, so
$(z_0^2-\gamma_0^2)^2 = \delta^4-4\gamma_0^2\delta^2+4i\gamma_0\delta^3$, hence
$\Re((z_0^2-\gamma_0^2)^2) = \delta^4-4\gamma_0^2\delta^2 \le -3\gamma_0^2\delta^2$ when $\gamma_0\ge\delta$.
Multiplying by the positive factor $|z_0^2+1/4|^2$ yields $\Re(A(z_0)^2) < 0$.
\end{proof}

\begin{remark}[Connection to off-critical zeros]
If an off-critical zero $\rho_0 = \frac12+\delta+i\gamma_0$ existed, then for the admissible test function
$g_{\gamma_0,\sigma}$, the contribution of that zero (and its symmetric partners) to the Weil form would be
$4m_0\Re(\wh g_{\gamma_0,\sigma}(z_0)^2)$ (with multiplicity $m_0$). Proposition~\ref{prop:complexamp} shows that this
contribution is negative and grows exponentially as $\sigma\to0$, providing the mechanism for the converse Weil criterion.
\end{remark}

\section{RH-conditional prime-sum inequality}

\begin{theorem}[RH-conditional weighted prime-sum inequality]\label{thm:RHineq}
Assume the Riemann Hypothesis.
Then for every $\sigma>0$ and $\gamma_0\ge 0$,
\[
\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\sqrt{n}}\,\Phi_{\gamma_0,\sigma}(\log n)
\le
\int_{0}^{\infty}\Re\Psi\!\Bigl(\frac14+\frac{i\gamma}{2}\Bigr)\,|\wh f_{\gamma_0,\sigma}(\gamma)|^2\,d\gamma
-\pi\,\Phi_{\gamma_0,\sigma}(0)\log\pi.
\]
\end{theorem}

\begin{proof}
Under RH, every non-trivial zero satisfies $\beta=\tfrac12$, hence $\gamma_\rho=\gamma\in\R$.
For $f_{\gamma_0,\sigma}\in\Szero$, $\wh f_{\gamma_0,\sigma}$ is real on $\R$ (as noted after Definition~\ref{def:f}),
so each term $\wh f_{\gamma_0,\sigma}(\gamma_\rho)^2$ is nonnegative.
Therefore $\mathcal W(f_{\gamma_0,\sigma})\ge 0$.
Substituting $\mathcal W=\mathcal K-\mathcal B$ from \eqref{eq:Wdecomp} together with \eqref{eq:Kdef}--\eqref{eq:Bdef} and rearranging yields the stated inequality.
\end{proof}

\subsection{Explicit convergence estimate}
From Theorem~\ref{thm:decomp}, the polynomials $\mathcal A_{\gamma_0,\sigma}$ and $\mathcal S_{\gamma_0,\sigma}$ are of degree $4$ and $3$, respectively.
Let $M(\sigma,\gamma_0)$ be the maximum absolute value of their coefficients. Then for all $x$,
\[
|\mathcal A_{\gamma_0,\sigma}(x)| \le M(\sigma,\gamma_0)(1+|x|^4),\qquad
|\mathcal S_{\gamma_0,\sigma}(x)| \le M(\sigma,\gamma_0)(1+|x|^3).
\]
Hence, using $|\cos|\le 1$, $|\sin|\le 1$, and $\mathcal A_{0,\sigma}(x)$ bounded similarly by $M_0(\sigma)(1+|x|^4)$,
we obtain
\[
|\Phi_{\gamma_0,\sigma}(x)| \le \frac{\sigma}{\sqrt{\pi}} e^{-\sigma^2 x^2/4}
\Bigl[ 2M(\sigma,\gamma_0)(1+|x|^4) + e^{-\gamma_0^2/\sigma^2} M_0(\sigma)(1+|x|^4) \Bigr]
\le C_1 e^{-\sigma^2 x^2/4}(1+|x|^4),
\]
with an explicit constant $C_1 = \frac{\sigma}{\sqrt{\pi}}(2M(\sigma,\gamma_0) + e^{-\gamma_0^2/\sigma^2} M_0(\sigma))$.
Setting $x=\log n$ gives $|\Phi_{\gamma_0,\sigma}(\log n)| \le C_1 n^{-\sigma^2 \log n/4} (1+|\log n|^4)$,
which decays super-exponentially, ensuring absolute convergence of the series $\sum \Lambda(n)n^{-1/2}\Phi(\log n)$.

\section{Conclusion}

We have provided a complete and rigorous exposition of explicit Gaussian constructions within the Weil quadratic-form framework.
The main contributions are:
\begin{itemize}
\item An exact shifted-Gaussian autocorrelation decomposition (Theorem~\ref{thm:decomp}) with fully derived polynomial coefficients
      $\mathcal A_{\gamma_0,\sigma}$, $\mathcal S_{\gamma_0,\sigma}$, and $\mathcal A_{0,\sigma}$.
\item A quantitative exponential decoupling bound with an explicit constant $C_\sigma$ (Theorem~\ref{thm:decouple}).
\item An exact complex-frequency evaluation with explicit relative error control (Proposition~\ref{prop:complexamp}),
      which provides the key mechanism for detecting off-critical zeros.
\item A fully explicit RH-conditional inequality for weighted prime sums (Theorem~\ref{thm:RHineq}).
\end{itemize}
All computations are self-contained and all constants are given explicitly. The formulas are elementary and suitable for both numerical experimentation and pedagogical study.

