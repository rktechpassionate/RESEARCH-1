%=======================================================================
\section{Introduction}
%=======================================================================

Let $\zeta(s)$ be the Riemann zeta function. For a non-trivial zero $\rho=\beta+i\gamma$ of $\zeta(s)$, define the spectral parameter
\[
\gamma_\rho := \frac{\rho-\frac12}{i} = \gamma - i\Bigl(\beta-\frac12\Bigr)\in\C.
\]
Thus $\gamma_\rho\in\R$ if and only if $\beta=\tfrac12$.

We work in the standard explicit-formula normalization and define the Weil functional by
\[
\mathcal W(f):=\mathcal K(f)-\mathcal B(f),
\]
where $\mathcal K(f)$ is the archimedean contribution and $\mathcal B(f)$ is the prime-sum contribution. The classical Weil criterion asserts that RH is equivalent to the non-negativity of $\mathcal W(f)$ on a suitable admissible test space.

We consider admissible test functions in the class
\[
\Szero := \Bigl\{f\in\Sch(\R): f \text{ even, real-valued, and } \wh f(\pm i/2)=0\Bigr\}.
\]
For such functions, the Guinand--Weil explicit formula gives
\begin{equation}\label{eq:Wdecomp}
\mathcal W(f)=\mathcal K(f)-\mathcal B(f),
\end{equation}
with
\begin{align}
\mathcal K(f)
&=
\frac{1}{\pi}\int_{0}^{\infty}\Repart\Psi\!\Bigl(\frac14+\frac{i\gamma}{2}\Bigr)\,|\wh f(\gamma)|^2\,d\gamma
-\Phi(0)\log\pi,\label{eq:Kdef}\\
\mathcal B(f)
&=
\frac{1}{\pi}\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\sqrt{n}}\,\Phi(\log n),\label{eq:Bdef}
\end{align}
where $\Psi=\Gamma'/\Gamma$, $\Lambda$ is the von Mangoldt function, and
\[
\Phi=f*\widetilde f,\qquad \widetilde f(x):=f(-x).
\]

This paper constructs a concrete family $\{f_{\gamma_0,\sigma}\}$ built from symmetrized Gaussians and proves explicit structural identities for its autocorrelation $\Phi_{\gamma_0,\sigma}$. We also derive RH-conditional prime-sum inequalities and several additional exact identities that are useful for numerical and analytic investigations.

%=======================================================================
\section{Preliminaries}
%=======================================================================

\subsection{Fourier transform convention}

We use
\[
\wh f(\xi)=\int_{\R}f(x)e^{-i\xi x}\,dx,
\qquad
f(x)=\frac1{2\pi}\int_{\R}\wh f(\xi)e^{i\xi x}\,d\xi.
\]
Parseval's identity reads
\[
\|f\|_{L^2(\R)}^2=\frac1{2\pi}\|\wh f\|_{L^2(\R)}^2.
\]

\subsection{Admissible test functions and Weil functional}

\begin{definition}\label{def:S0}
Let $\Szero$ denote the space of even, real-valued Schwartz functions $f$ on $\R$ such that $\wh f(\pm i/2)=0$.
For $f\in\Szero$, define the Weil functional by \eqref{eq:Wdecomp}.
\end{definition}

\subsection{Digamma asymptotics and convergence}

For $\gamma>0$,
\[
\Repart\Psi\!\Bigl(\frac14+\frac{i\gamma}{2}\Bigr)=\log(\gamma/2)+O\!\Bigl(\frac1{\gamma^2}\Bigr)
\qquad (\gamma\to\infty),
\]
and $|\Repart\Psi(\tfrac14+i\gamma/2)|\le C$ for $0<\gamma\le 1$.

Since the Fourier-side profiles below are Gaussian times a polynomial, all integrals in \eqref{eq:Kdef} converge absolutely. The prime sum in \eqref{eq:Bdef} converges absolutely because the autocorrelation decays like a Gaussian times a polynomial, hence faster than any power of $n$ after the substitution $x=\log n$.

%=======================================================================
\section{The entire Gaussian family}
%=======================================================================

\begin{definition}\label{def:f}
Fix $\sigma>0$ and $\gamma_0\ge 0$. Define the Fourier-side function
\begin{equation}\label{eq:fhat}
\wh f_{\gamma_0,\sigma}(\gamma)
=
\Bigl(\gamma^2+\frac14\Bigr)
\left(
e^{-(\gamma-\gamma_0)^2/(2\sigma^2)}
+
e^{-(\gamma+\gamma_0)^2/(2\sigma^2)}
\right),
\qquad \gamma\in\C.
\end{equation}
Let $f_{\gamma_0,\sigma}$ be the inverse Fourier transform of $\wh f_{\gamma_0,\sigma}$.
Define the autocorrelation
\[
\Phi_{\gamma_0,\sigma}:=f_{\gamma_0,\sigma}*\widetilde f_{\gamma_0,\sigma}.
\]
\end{definition}

\begin{lemma}[Admissibility]\label{lem:admissible}
For every $\sigma>0$ and $\gamma_0\ge 0$, one has $f_{\gamma_0,\sigma}\in\Szero$.
\end{lemma}

\begin{proof}
The right-hand side of \eqref{eq:fhat} is entire and even in $\gamma$, and it is real-valued for $\gamma\in\R$.
Moreover it vanishes at $\gamma=\pm i/2$ due to the factor $\gamma^2+\frac14$.
Since it is a Gaussian times a polynomial, its restriction to $\R$ is Schwartz, so its inverse Fourier transform is even, real-valued, and Schwartz. Hence $f_{\gamma_0,\sigma}\in\Szero$.
\end{proof}

%=======================================================================
\section{Gaussian moment integrals}
%=======================================================================

\begin{lemma}\label{lem:moments}
For $\sigma>0$ and $k\in\{0,1,2,3,4\}$, define
\[
I_k(x;\sigma)=\int_{-\infty}^{\infty} u^k e^{-u^2/\sigma^2}e^{iux}\,du.
\]
Then
\begin{align*}
I_0 &= \sigma\sqrt{\pi}\,e^{-\sigma^2 x^2/4},\\
I_1 &= i\,\frac{\sigma^3\sqrt{\pi}}{2}\,x\,e^{-\sigma^2 x^2/4},\\
I_2 &= \sigma\sqrt{\pi}\left(\frac{\sigma^2}{2} - \frac{\sigma^4 x^2}{4}\right)e^{-\sigma^2 x^2/4},\\
I_3 &= i\,\sigma\sqrt{\pi}\left(\frac{3\sigma^4 x}{4} - \frac{\sigma^6 x^3}{8}\right)e^{-\sigma^2 x^2/4},\\
I_4 &= \sigma\sqrt{\pi}\left(\frac{3\sigma^4}{4} - \frac{3\sigma^6 x^2}{4} + \frac{\sigma^8 x^4}{16}\right)e^{-\sigma^2 x^2/4}.
\end{align*}
\end{lemma}

\begin{proof}
The base case $I_0$ follows by completing the square. For $k\ge 1$, note that
$u e^{iux}=-i\frac{d}{dx}e^{iux}$, so $I_k=(-i)^k\frac{d^k}{dx^k}I_0$.
\end{proof}

%=======================================================================
\section{Exact shifted-Gaussian autocorrelation decomposition}
%=======================================================================

\begin{theorem}[Shifted-Gaussian autocorrelation decomposition]\label{thm:decomp}
For any $x\in\R$,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt{\pi}}e^{-\sigma^2 x^2/4}
\Bigl[
\mathcal A_{\gamma_0,\sigma}(x)\cos(\gamma_0 x)
-
\mathcal S_{\gamma_0,\sigma}(x)\sin(\gamma_0 x)
+
e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\Bigr],
\]
where
\begin{align}
\mathcal A_{\gamma_0,\sigma}(x)
&=
\Bigl(\gamma_0^4+\frac{\gamma_0^2}{2}+3\gamma_0^2\sigma^2+\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\Bigr)
-\Bigl(\frac{3\gamma_0^2\sigma^4}{2}+\frac{3\sigma^6}{4}+\frac{\sigma^4}{8}\Bigr)x^2
+\frac{\sigma^8}{16}x^4,\label{eq:A}\\[2pt]
\mathcal S_{\gamma_0,\sigma}(x)
&=
\gamma_0\Bigl(2\gamma_0^2\sigma^2+3\sigma^4+\frac{\sigma^2}{2}\Bigr)x
-\frac{\gamma_0\sigma^6}{2}x^3,\label{eq:S}\\[2pt]
\mathcal A_{0,\sigma}(x)
&=
\Bigl(\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\Bigr)
-\Bigl(\frac{3\sigma^6}{4}+\frac{\sigma^4}{8}\Bigr)x^2
+\frac{\sigma^8}{16}x^4.\label{eq:A0}
\end{align}
\end{theorem}

\begin{proof}
From \eqref{eq:fhat},
\[
|\wh f_{\gamma_0,\sigma}(\gamma)|^2
=
\Bigl(\gamma^2+\frac14\Bigr)^2
\left[
e^{-(\gamma-\gamma_0)^2/\sigma^2}
+e^{-(\gamma+\gamma_0)^2/\sigma^2}
+2e^{-(\gamma^2+\gamma_0^2)/\sigma^2}
\right].
\]
Let the three summands be $A_+(\gamma)$, $A_-(\gamma)$, and $B(\gamma)$.

\smallskip
\noindent\textbf{Shifted terms.}
For $A_+$, substitute $u=\gamma-\gamma_0$. Then
\[
\bigl[(u+\gamma_0)^2+\tfrac14\bigr]^2
=
u^4+4\gamma_0u^3+\Bigl(6\gamma_0^2+\tfrac12\Bigr)u^2+(4\gamma_0^3+\gamma_0)u+\Bigl(\gamma_0^4+\tfrac{\gamma_0^2}{2}+\tfrac1{16}\Bigr).
\]
Using Lemma~\ref{lem:moments}, this yields
\[
I_+(x)
=
\frac{\sigma}{2\sqrt{\pi}}e^{-\sigma^2x^2/4}e^{i\gamma_0x}
\bigl[\mathcal A_{\gamma_0,\sigma}(x)+i\mathcal S_{\gamma_0,\sigma}(x)\bigr].
\]
For $A_-$, the same calculation with $\gamma_0\mapsto -\gamma_0$ gives
\[
I_-(x)
=
\frac{\sigma}{2\sqrt{\pi}}e^{-\sigma^2x^2/4}e^{-i\gamma_0x}
\bigl[\mathcal A_{\gamma_0,\sigma}(x)-i\mathcal S_{\gamma_0,\sigma}(x)\bigr].
\]
Adding them gives the cosine and sine terms.

\smallskip
\noindent\textbf{Diagonal term.}
For $B(\gamma)=2(\gamma^2+\tfrac14)^2e^{-(\gamma^2+\gamma_0^2)/\sigma^2}$,
the same moment computation with $\gamma_0=0$ gives
\[
I_B(x)=e^{-\gamma_0^2/\sigma^2}\frac{\sigma}{\sqrt{\pi}}e^{-\sigma^2x^2/4}\mathcal A_{0,\sigma}(x).
\]

Summing $I_++I_-+I_B$ gives the claim.
\end{proof}

\begin{remark}[Evenness check]
The cosine term is even, the sine term is odd times odd and hence even, and the diagonal term is even; thus $\Phi_{\gamma_0,\sigma}(-x)=\Phi_{\gamma_0,\sigma}(x)$, as required.
\end{remark}

%=======================================================================
\section{Additional exact identities}
%=======================================================================

\subsection{Exact mass, $L^2$ norm, and spectral curvature}

\begin{theorem}[Exact total mass and $L^2$ norm]\label{thm:mass_L2}
For the Gaussian family $f_{\gamma_0,\sigma}$ of Definition~\ref{def:f},
\[
\Phi_{\gamma_0,\sigma}(0)=\|f_{\gamma_0,\sigma}\|_{L^2(\R)}^2
=
\frac{\sigma}{\sqrt\pi}\left(
\gamma_0^4+\frac{\gamma_0^2}{2}+3\gamma_0^2\sigma^2+\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}
+e^{-\gamma_0^2/\sigma^2}\left(\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\right)
\right).
\]
Moreover,
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx=\frac14\,e^{-\gamma_0^2/\sigma^2}.
\]
\end{theorem}

\begin{proof}
Evaluate Theorem~\ref{thm:decomp} at $x=0$, noting that $\sin(0)=0$ and $\cos(0)=1$.
For the total mass, use Fourier inversion:
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx=\widehat{\Phi}_{\gamma_0,\sigma}(0)=|\wh f_{\gamma_0,\sigma}(0)|^2.
\]
Since
\[
\wh f_{\gamma_0,\sigma}(0)
=
\frac14\left(e^{-\gamma_0^2/(2\sigma^2)}+e^{-\gamma_0^2/(2\sigma^2)}\right)
=
\frac12 e^{-\gamma_0^2/(2\sigma^2)},
\]
the mass identity follows.
\end{proof}

\begin{corollary}[Exponential mass localization]\label{cor:mass_localization}
As $\gamma_0/\sigma\to\infty$,
\[
\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx = O\!\left(e^{-\gamma_0^2/\sigma^2}\right).
\]
\end{corollary}

\begin{proof}
Immediate from Theorem~\ref{thm:mass_L2}.
\end{proof}

\begin{theorem}[Spectral curvature at the origin]\label{thm:curvature}
The Fourier transform of $\Phi_{\gamma_0,\sigma}$ satisfies
\[
\widehat{\Phi}_{\gamma_0,\sigma}''(0)
=
e^{-\gamma_0^2/\sigma^2}\left(
4+\frac{\gamma_0^2}{2\sigma^4}-\frac{1}{2\sigma^2}
\right).
\]
Equivalently,
\[
\int_{\R}x^2\Phi_{\gamma_0,\sigma}(x)\,dx
=
-e^{-\gamma_0^2/\sigma^2}\left(
4+\frac{\gamma_0^2}{2\sigma^4}-\frac{1}{2\sigma^2}
\right).
\]
\end{theorem}

\begin{proof}
Write
\[
\widehat{\Phi}_{\gamma_0,\sigma}(\xi)
=
P(\xi)\,Q(\xi),\qquad P(\xi)=\Bigl(\xi^2+\frac14\Bigr)^2,
\]
where
\[
Q(\xi)=e^{-(\xi-\gamma_0)^2/\sigma^2}+e^{-(\xi+\gamma_0)^2/\sigma^2}+2e^{-(\xi^2+\gamma_0^2)/\sigma^2}.
\]
Then $P(0)=1/16$, $P''(0)=1$, and
\[
Q(0)=4e^{-\gamma_0^2/\sigma^2},\qquad
Q''(0)=\left(\frac{8\gamma_0^2}{\sigma^4}-\frac{8}{\sigma^2}\right)e^{-\gamma_0^2/\sigma^2}.
\]
Hence
\[
\widehat{\Phi}_{\gamma_0,\sigma}''(0)=P''(0)Q(0)+P(0)Q''(0)
=
e^{-\gamma_0^2/\sigma^2}\left(
4+\frac{\gamma_0^2}{2\sigma^4}-\frac{1}{2\sigma^2}
\right).
\]
The second formula follows from $\widehat{\Phi}''(0)= -\int x^2\Phi(x)\,dx$.
\end{proof}

\subsection{Large-frequency asymptotics and parameter sensitivity}

\begin{theorem}[Large-$\gamma_0$ asymptotic profile]\label{thm:large_gamma0}
Fix $\sigma>0$, and let $K\subset\R$ be compact. Then uniformly for $x\in K$,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}e^{-\sigma^2x^2/4}
\left(
\gamma_0^4\cos(\gamma_0x)-2\gamma_0^3\sigma^2x\sin(\gamma_0x)+O_{\sigma,K}(\gamma_0^2)
\right)
\qquad (\gamma_0\to\infty).
\]
\end{theorem}

\begin{proof}
From Theorem~\ref{thm:decomp},
\[
\mathcal A_{\gamma_0,\sigma}(x)=\gamma_0^4+O_{\sigma,K}(\gamma_0^2),
\qquad
\mathcal S_{\gamma_0,\sigma}(x)=2\gamma_0^3\sigma^2x+O_{\sigma,K}(\gamma_0),
\]
uniformly for $x\in K$, while the diagonal term is exponentially small.
Substitution gives the claim.
\end{proof}

\begin{corollary}[Leading oscillatory profile]\label{cor:leading_profile}
For fixed $\sigma>0$ and bounded $x$,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}\gamma_0^4e^{-\sigma^2x^2/4}\cos(\gamma_0x)
+O_\sigma(\gamma_0^3).
\]
\end{corollary}

\begin{proposition}[Exact $\gamma_0$-derivatives of the structural polynomials]\label{prop:sensitivity}
The polynomials in Theorem~\ref{thm:decomp} satisfy
\[
\partial_{\gamma_0}\mathcal A_{\gamma_0,\sigma}(x)
=
4\gamma_0^3+\gamma_0\Bigl(1+6\sigma^2-3\sigma^4x^2\Bigr),
\]
and
\[
\partial_{\gamma_0}\mathcal S_{\gamma_0,\sigma}(x)
=
x\Bigl(6\gamma_0^2\sigma^2+\frac{\sigma^2}{2}+3\sigma^4\Bigr)
-\frac{\sigma^6}{2}x^3.
\]
Consequently,
\[
\partial_{\gamma_0}\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}e^{-\sigma^2x^2/4}
\Bigl[
(\partial_{\gamma_0}\mathcal A_{\gamma_0,\sigma}(x))\cos(\gamma_0x)
-\mathcal A_{\gamma_0,\sigma}(x)x\sin(\gamma_0x)
-(\partial_{\gamma_0}\mathcal S_{\gamma_0,\sigma}(x))\sin(\gamma_0x)
-\mathcal S_{\gamma_0,\sigma}(x)x\cos(\gamma_0x)
-\frac{2\gamma_0}{\sigma^2}e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\Bigr].
\]
\end{proposition}

\begin{proof}
Differentiate \eqref{eq:A}--\eqref{eq:A0} term by term, then differentiate \eqref{eq:decomp}.
\end{proof}

\begin{corollary}[Monotone decay of the total mass]\label{cor:mass_derivative}
The total mass satisfies
\[
\frac{d}{d\gamma_0}\int_{\R}\Phi_{\gamma_0,\sigma}(x)\,dx
=
-\frac{\gamma_0}{2\sigma^2}e^{-\gamma_0^2/\sigma^2}.
\]
In particular, for $\gamma_0>0$ the total mass decreases strictly as $\gamma_0$ increases.
\end{corollary}

\begin{proof}
Differentiate the exact identity from Theorem~\ref{thm:mass_L2}.
\end{proof}

%=======================================================================
\section{Oscillatory decoupling with an explicit constant}
%=======================================================================

\begin{theorem}[Exponential decoupling with explicit uniform bound]\label{thm:decouple}
For all $x\in\R$,
\[
\left|
\frac{\sigma}{\sqrt{\pi}}e^{-\sigma^2x^2/4}e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\right|
\le
C_\sigma\,e^{-\gamma_0^2/\sigma^2},
\]
where one may take
\[
C_\sigma=\frac{\sigma}{\sqrt{\pi}}\left(\frac{3\sigma^4}{4}+\frac{\sigma^2}{4}+\frac1{16}\right).
\]
Moreover, for every integer $N\ge 0$ there exists $C_{\sigma,N}>0$ such that
\[
\left|
\frac{\sigma}{\sqrt{\pi}}e^{-\sigma^2x^2/4}e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\right|
\le
C_{\sigma,N}e^{-\gamma_0^2/\sigma^2}(1+|x|)^{-N}.
\]
\end{theorem}

\begin{proof}
The supremum occurs at $x=0$ since the Gaussian factor dominates the polynomial growth.
The $N$-dependent estimate follows because a Gaussian times a polynomial is Schwartz.
\end{proof}

%=======================================================================
\section{Complex-frequency amplification identity}
%=======================================================================

\begin{definition}\label{def:notch}
For $\delta>0$, define the notch-filtered family
\[
\wh g_{\gamma_0,\sigma}(\gamma):=(\gamma^2-\gamma_0^2)\wh f_{\gamma_0,\sigma}(\gamma).
\]
Let $z_0:=\gamma_0-i\delta$.
\end{definition}

\begin{proposition}[Complex-frequency amplification with explicit error]\label{prop:complexamp}
Fix $\delta>0$ and $\gamma_0\ge 0$. For $z_0=\gamma_0-i\delta$,
\[
\wh g_{\gamma_0,\sigma}(z_0)
=
(z_0^2-\gamma_0^2)\Bigl(z_0^2+\frac14\Bigr)\,
e^{\delta^2/(2\sigma^2)}\,(1+\Theta_{\gamma_0,\delta,\sigma}),
\]
with
\[
\Theta_{\gamma_0,\delta,\sigma}
=
e^{-2\gamma_0^2/\sigma^2}\,e^{2i\gamma_0\delta/\sigma^2},
\qquad
|\Theta_{\gamma_0,\delta,\sigma}|=e^{-2\gamma_0^2/\sigma^2}.
\]
Moreover,
\[
\left|
\Repart\bigl(\wh g_{\gamma_0,\sigma}(z_0)^2\bigr)-\Repart\bigl(A(z_0)^2\bigr)e^{\delta^2/\sigma^2}
\right|
\le
3e^{-2\gamma_0^2/\sigma^2}|A(z_0)|^2e^{\delta^2/\sigma^2},
\]
where $A(z_0)=(z_0^2-\gamma_0^2)(z_0^2+\tfrac14)$.
If $\gamma_0\ge\delta$, then
\[
\Repart\!\bigl((z_0^2-\gamma_0^2)^2\bigr)=\delta^4-4\gamma_0^2\delta^2\le -3\gamma_0^2\delta^2.
\]
\end{proposition}

\begin{proof}
Substitute $\gamma=z_0$ into the definition of $\wh g_{\gamma_0,\sigma}$. Since $z_0-\gamma_0=-i\delta$,
\[
e^{-(z_0-\gamma_0)^2/(2\sigma^2)}=e^{\delta^2/(2\sigma^2)}.
\]
Also $z_0+\gamma_0=2\gamma_0-i\delta$, so
\[
e^{-(z_0+\gamma_0)^2/(2\sigma^2)}
=
e^{-2\gamma_0^2/\sigma^2}e^{\delta^2/(2\sigma^2)}e^{2i\gamma_0\delta/\sigma^2}.
\]
This gives the exact factorization. The squared estimate follows from $(1+\Theta)^2=1+2\Theta+\Theta^2$.
The sign claim is a direct expansion.
\end{proof}

\begin{remark}[Local sign mechanism]
The preceding proposition isolates the local negative-sign mechanism that underlies converse-style constructions in the explicit-formula setting. It is a local analytic statement and does not by itself prove the full converse criterion.
\end{remark}

%=======================================================================
\section{Phase discriminant}
%=======================================================================

\begin{theorem}[Quadratic phase discriminant]\label{thm:phase}
Let $u,v\in\C$ and define
\[
Q(t):=\Repart[(u+tv)^2],\qquad t\in\R.
\]
Write
\[
A=\Repart(v^2),\qquad B=2\Repart(uv),\qquad C=\Repart(u^2),
\qquad I=\Impart(u\overline v).
\]
Then:
\begin{enumerate}[label=(\alph*),nosep]
  \item $Q(t)=At^2+Bt+C$;
  \item $B^2-4AC=4I^2$;
  \item if $A>0$, then the minimum occurs at $t_*=-B/(2A)$ and equals
  \[
  Q(t_*)=-\frac{I^2}{A};
  \]
  \item if $I\neq0$, then there exists $t\in\R$ such that $Q(t)<0$.
\end{enumerate}
\end{theorem}

\begin{proof}
Expand $(u+tv)^2=u^2+2tuv+t^2v^2$ and take real parts. The discriminant computation is a direct componentwise identity after writing $u=u_1+iu_2$ and $v=v_1+iv_2$.
\end{proof}

%=======================================================================
\section{Local finite-part regularization near a zeta zero}
%=======================================================================

\begin{proposition}[Finite-part identity]\label{prop:finitepart}
Let $\rho_0$ be a zero of $\zeta(s)$ of multiplicity $m\ge1$. Write
\[
\zeta(s)=(s-\rho_0)^m g(s),
\]
with $g(\rho_0)\neq0$ and $g$ holomorphic near $\rho_0$. Then as $s\to\rho_0$,
\[
-\frac{\zeta'(s)}{\zeta(s)}
=
-\frac{m}{s-\rho_0}+c_0+O(s-\rho_0),
\qquad
c_0=-\frac{g'(\rho_0)}{g(\rho_0)}.
\]
Moreover, for $X>1$,
\[
\frac{mX^{\rho_0-s}}{\rho_0-s}
=
-\frac{m}{s-\rho_0}+m\log X+O(s-\rho_0),
\]
and therefore
\[
-\frac{\zeta'(s)}{\zeta(s)}-\frac{mX^{\rho_0-s}}{\rho_0-s}
=
c_0-m\log X+O(s-\rho_0).
\]
In particular,
\[
\operatorname{FP}_{s=\rho_0}\left(\frac{mX^{\rho_0-s}}{\rho_0-s}\right)=m\log X.
\]
\end{proposition}

\begin{proof}
Differentiate $\zeta(s)=(s-\rho_0)^m g(s)$ and use the Taylor expansion
$X^{\rho_0-s}=e^{-(s-\rho_0)\log X}$.
\end{proof}

%=======================================================================
\section{RH-conditional prime-sum inequality}
%=======================================================================

\begin{theorem}[RH-conditional weighted prime-sum inequality]\label{thm:RHineq}
Assume the Riemann Hypothesis. Then for every $\sigma>0$ and $\gamma_0\ge 0$,
\[
\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\sqrt{n}}\,\Phi_{\gamma_0,\sigma}(\log n)
\le
\int_{0}^{\infty}\Repart\Psi\!\Bigl(\frac14+\frac{i\gamma}{2}\Bigr)\,|\wh f_{\gamma_0,\sigma}(\gamma)|^2\,d\gamma
-\pi\,\Phi_{\gamma_0,\sigma}(0)\log\pi.
\]
\end{theorem}

\begin{proof}
Under RH, every non-trivial zero satisfies $\beta=\tfrac12$, so the spectral parameters are real.
For admissible $f_{\gamma_0,\sigma}$, the Weil functional is nonnegative. Substituting \eqref{eq:Wdecomp}--\eqref{eq:Bdef} and rearranging gives the stated inequality.
\end{proof}

\begin{proposition}[Prime-window decomposition]\label{prop:prime_window}
With $\Phi_{\gamma_0,\sigma}$ from Theorem~\ref{thm:decomp},
\[
\mathcal B(f_{\gamma_0,\sigma})
=
\frac{1}{\pi}\sum_{n=2}^{\infty}\frac{\Lambda(n)}{\sqrt{n}}\,
\frac{\sigma}{\sqrt\pi}\,e^{-\sigma^2(\log n)^2/4}
\Bigl[
\mathcal A_{\gamma_0,\sigma}(\log n)\cos(\gamma_0\log n)
-
\mathcal S_{\gamma_0,\sigma}(\log n)\sin(\gamma_0\log n)
+
e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(\log n)
\Bigr].
\]
Moreover, the sum converges absolutely.
\end{proposition}

\begin{proof}
This is immediate from \eqref{eq:Bdef} and Theorem~\ref{thm:decomp}. Absolute convergence follows because
\[
\Phi_{\gamma_0,\sigma}(x)\ll_{\sigma,\gamma_0}(1+|x|^4)e^{-\sigma^2x^2/4},
\]
so after inserting $x=\log n$ one gets super-polynomial decay in $n$.
\end{proof}

