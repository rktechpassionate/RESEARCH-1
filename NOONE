\subsection{Large-frequency asymptotics}

\begin{theorem}[Large-$\gamma_0$ asymptotic profile]\label{thm:large_gamma0}
Fix $\sigma>0$, and let $K\subset\R$ be compact. Then uniformly for $x\in K$,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}e^{-\sigma^2x^2/4}
\left(
\gamma_0^4\cos(\gamma_0x)-2\gamma_0^3\sigma^2x\sin(\gamma_0x)+O_{\sigma,K}(\gamma_0^2)
\right)
\qquad (\gamma_0\to\infty).
\]
Equivalently,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}\gamma_0^4e^{-\sigma^2x^2/4}\cos(\gamma_0x)
+O_{\sigma,K}(\gamma_0^3).
\]
\end{theorem}

\begin{proof}
From Theorem~\ref{thm:decomp},
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}e^{-\sigma^2x^2/4}
\Bigl[
\mathcal A_{\gamma_0,\sigma}(x)\cos(\gamma_0x)
-\mathcal S_{\gamma_0,\sigma}(x)\sin(\gamma_0x)
+e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)
\Bigr].
\]
For $x\in K$ fixed and $\gamma_0\to\infty$,
\[
\mathcal A_{\gamma_0,\sigma}(x)
=
\gamma_0^4
+\gamma_0^2\Bigl(\frac12+3\sigma^2-\frac{3\sigma^4x^2}{2}\Bigr)
+O_{\sigma,K}(1),
\]
and
\[
\mathcal S_{\gamma_0,\sigma}(x)
=
2\gamma_0^3\sigma^2x+O_{\sigma,K}(\gamma_0).
\]
The diagonal term $e^{-\gamma_0^2/\sigma^2}\mathcal A_{0,\sigma}(x)$ is exponentially smaller than any power of $\gamma_0$.
Substituting these expansions yields the result.
\end{proof}

\begin{corollary}[Leading oscillatory profile]\label{cor:leading_profile}
For fixed $\sigma>0$ and bounded $x$,
\[
\Phi_{\gamma_0,\sigma}(x)
=
\frac{\sigma}{\sqrt\pi}\gamma_0^4e^{-\sigma^2x^2/4}\cos(\gamma_0x)
+O_\sigma(\gamma_0^3).
\]
\end{corollary}

